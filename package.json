{
  "name": "ai-leverage-library",
  "version": "0.1.0",
  "private": true,
  "description": "A Git-native field manual of reproducible AI techniques.",
  "type": "module",
  "scripts": {
    "experiment:new": "node scripts/create-experiment.mjs",
    "test:intake": "node --test tests/experiment-intake.test.mjs tests/validate-experiments.test.mjs",
    "validate": "npm run validate:project-state && npm run test:intake && npm run test:proof-packet && npm run validate:experiments && npm run validate:proof-packet && npm run validate:techniques",
    "validate:experiments": "node scripts/validate-experiments.mjs",
    "validate:project-state": "node scripts/validate-project-state.mjs",
    "test:proof-packet": "node --test tests/verify-proof-packet.test.mjs",
    "validate:proof-packet": "node scripts/verify-proof-packet.mjs",
    "validate:techniques": "node scripts/validate.mjs",
    "test": "npm run validate",
    "build": "npm run validate"
  },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED"
}
